# BIGTREETECH Manta M8P V2.0: STM32H723, 128KiB bootloader, 25 MHz crystal,
# USB (on PA11/PA12) -- per tricca-autopipette.cfg's header comment. Minimal
# input like klipper-host-mcu.config: klipper-firmware.nix's configurePhase
# runs `make menuconfig` in auto-accept mode to fill in/validate the rest.
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32H723=y
CONFIG_STM32_FLASH_START_20000=y
# Clock Reference is only prompted (and CLOCK_REF_25M only takes effect)
# with LOW_LEVEL_OPTIONS on -- without it this silently defaulted to 8 MHz,
# verified via the built config's CONFIG_CLOCK_REF_FREQ=8000000, wrong for
# this board's actual 25 MHz crystal.
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_STM32_CLOCK_REF_25M=y
CONFIG_STM32_USB_PA11_PA12=y
